{
  "$schema": "https://raw.githubusercontent.com/nicedoc/api/refs/heads/master/schemas/tauri/tauri.conf.schema.json",
  "productName": "AudioMuse-AI",
  "version": "0.9.3",
  "identifier": "com.audiomuse-ai.desktop",
  "build": {
    "frontendDist": "../frontend-placeholder",
    "devUrl": "http://127.0.0.1:8000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "AudioMuse-AI",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "http://127.0.0.1:8000",
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": [],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": null,
      "entitlements": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
